{
  "name": "project-delivery-manager",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @project-delivery/web --filter @project-delivery/api dev",
    "dev:api": "corepack pnpm --filter @project-delivery/api dev",
    "dev:web": "corepack pnpm --filter @project-delivery/web dev",
    "build": "corepack pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "verify": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "verify:e2e:local": "corepack pnpm test:e2e:gate-check && corepack pnpm test:e2e:list && corepack pnpm test:e2e:local",
    "test:e2e": "bash scripts/e2e/playwright-gate.sh",
    "test:e2e:list": "playwright test --list",
    "test:e2e:gate-check": "bash scripts/e2e/assert-gate-fails.sh",
    "test:e2e:full": "bash scripts/e2e/run.sh",
    "test:e2e:local": "bash scripts/e2e/run-local.sh",
    "e2e:up": "bash scripts/e2e/up.sh",
    "e2e:down": "bash scripts/e2e/down.sh",
    "upd:pack": "tsx scripts/upd/release-cli.ts pack",
    "upd:validate": "tsx scripts/upd/release-cli.ts validate",
    "upd:checksums": "tsx scripts/upd/release-cli.ts checksums",
    "upd:state": "tsx scripts/upd/state-cli.ts",
    "upd:test": "vitest run scripts/upd/upd.test.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/engines",
      "@swc/core",
      "argon2",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.7.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "10.3.0",
    "jsdom": "^29.1.1",
    "prettier": "3.8.3",
    "prisma": "7.8.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.6"
  }
}
