{
  "name": "project-delivery-manager",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @project-delivery/web --filter @project-delivery/api dev",
    "dev:api": "corepack pnpm --filter @project-delivery/api dev",
    "dev:web": "corepack pnpm --filter @project-delivery/web dev",
    "build": "corepack pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "esbuild", "sharp"]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.7.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.3.0",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.6"
  }
}
