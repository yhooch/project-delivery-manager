{
  "name": "@project-delivery/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "prisma:generate": "prisma generate --config ../../prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config ../../prisma.config.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@nestjs/common": "11.1.20",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.20",
    "@nestjs/platform-express": "11.1.20",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@project-delivery/shared": "workspace:*",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "pg": "^8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "^3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.19",
    "@types/cookie-parser": "^1.4.10",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2"
  }
}
