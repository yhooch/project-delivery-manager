# Copy this file to .env.prod and change every CHANGE_ME value before deploy.
#
# Build deployment:
# docker compose -p pdm-prod --env-file .env.prod -f docker-compose.prod.yml build api web
# docker compose -p pdm-prod --env-file .env.prod -f docker-compose.prod.yml up -d postgres minio minio-init
# docker compose -p pdm-prod --env-file .env.prod -f docker-compose.prod.yml run --rm api corepack pnpm exec prisma migrate deploy --config prisma.config.ts
# docker compose -p pdm-prod --env-file .env.prod -f docker-compose.prod.yml up -d
#
# Release image deployment:
# 1. Set PDM_API_IMAGE/PDM_WEB_IMAGE to immutable digest references.
# 2. Set PDM_APP_VERSION/PDM_COMMIT/PDM_BUILD_TIME and image digest proof fields.
# 3. Set PDM_API_PULL_POLICY/PDM_WEB_PULL_POLICY to always.
# 4. Run:
# docker compose -p pdm-prod --env-file .env.prod -f docker-compose.prod.yml pull api web
# docker compose -p pdm-prod --env-file .env.prod -f docker-compose.prod.yml up -d postgres minio minio-init
# docker compose -p pdm-prod --env-file .env.prod -f docker-compose.prod.yml run --rm api corepack pnpm exec prisma migrate deploy --config prisma.config.ts
# docker compose -p pdm-prod --env-file .env.prod -f docker-compose.prod.yml up -d

NODE_ENV=production
APP_TIMEZONE=Asia/Shanghai
MINIO_TIMEZONE=CST-8
HTTP_PORT=80

# Runtime release proof and image selection.
# Keep the local values for build deployment. For release deployment, replace
# image values with registry.example.com/pdm/api@sha256:<digest> style references.
PDM_RELEASE_ID=local-build
PDM_APP_VERSION=local-build
PDM_COMMIT=unknown
PDM_BUILD_TIME=unknown
PDM_RELEASE_CHANNEL=development
PDM_API_IMAGE=pdm-api:local
PDM_WEB_IMAGE=pdm-web:local
PDM_API_IMAGE_DIGEST=unknown
PDM_WEB_IMAGE_DIGEST=unknown
PDM_API_PULL_POLICY=build
PDM_WEB_PULL_POLICY=build

# Public browser origin. Keep this exact origin aligned with the address users open.
WEB_APP_URL=http://your-domain-or-ip

# HTTP deployment: must be false or browser login cookies will be ignored.
SESSION_COOKIE_NAME=pdm_session
SESSION_COOKIE_SECURE=false

POSTGRES_DB=crm_manager
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

MINIO_PUBLIC_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=http://your-domain-or-ip:9000
MINIO_BUCKET=crm-manager-attachments
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
MINIO_AUTO_CREATE_BUCKET=false

NEXT_PUBLIC_API_BASE_PATH=/api/v1
API_PROXY_TARGET=http://api:3001
