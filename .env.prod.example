# Copy this file to .env.prod and change every CHANGE_ME value before deploy.
#
# Preferred production deploy with a domestic private registry:
# docker compose -p pdm-prod --env-file .env.prod -f docker-compose.prod.yml -f docker-compose.prod.registry.yml pull
# docker compose -p pdm-prod --env-file .env.prod -f docker-compose.prod.yml -f docker-compose.prod.registry.yml up -d postgres minio minio-init --no-build
# docker compose -p pdm-prod --env-file .env.prod -f docker-compose.prod.yml -f docker-compose.prod.registry.yml run --rm --no-deps api corepack pnpm exec prisma migrate deploy --config prisma.config.ts
# docker compose -p pdm-prod --env-file .env.prod -f docker-compose.prod.yml -f docker-compose.prod.registry.yml up -d --no-build
#
# Fallback when the private registry is unavailable:
# build/pull images on a network-good machine, docker save, upload to the server,
# docker load, then deploy with an environment-specific override that pins local
# image tags.

NODE_ENV=production
APP_TIMEZONE=Asia/Shanghai
MINIO_TIMEZONE=CST-8
HTTP_PORT=80

# Domestic private registry images.
# Set PRIVATE_REGISTRY to the actual namespace, for example:
# registry.cn-hangzhou.aliyuncs.com/your-namespace/crm-manager
PRIVATE_REGISTRY=CHANGE_ME_PRIVATE_REGISTRY_NAMESPACE
APP_IMAGE_TAG=CHANGE_ME_GIT_COMMIT_OR_RELEASE_TAG
API_IMAGE=${PRIVATE_REGISTRY}/api:${APP_IMAGE_TAG}
WEB_IMAGE=${PRIVATE_REGISTRY}/web:${APP_IMAGE_TAG}
POSTGRES_IMAGE=${PRIVATE_REGISTRY}/postgres:16-alpine
MINIO_IMAGE=${PRIVATE_REGISTRY}/minio:latest
MINIO_MC_IMAGE=${PRIVATE_REGISTRY}/minio-mc:latest
NGINX_IMAGE=${PRIVATE_REGISTRY}/nginx:1.27-alpine

# Public browser/API/MCP origin. Keep this exact origin aligned with the address users and Codex open.
WEB_APP_URL=http://your-domain-or-ip
API_PUBLIC_URL=http://your-domain-or-ip
MCP_OAUTH_ISSUER=http://your-domain-or-ip
MCP_CANONICAL_RESOURCE_URI=http://your-domain-or-ip/api/v1/mcp

# HTTP deployment: must be false or browser login cookies will be ignored.
SESSION_COOKIE_NAME=pdm_session
SESSION_COOKIE_SECURE=false

POSTGRES_DB=crm_manager
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

MINIO_PUBLIC_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_ENDPOINT=http://your-domain-or-ip:9000
MINIO_BUCKET=crm-manager-attachments
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
MINIO_AUTO_CREATE_BUCKET=false

NEXT_PUBLIC_API_BASE_PATH=/api/v1
API_PROXY_TARGET=http://api:3001
