  @@index([organizationId, actorId, createdAt], map: "timeline_events_org_actor_created_idx")
  @@index([eventType])
  @@map("timeline_events")
}

model AuditLog {
  id             String   @id @db.Char(26)
  organizationId String   @map("organization_id") @db.Char(26)
  spaceId        String?  @map("space_id") @db.Char(26)
  actorId        String?  @map("actor_id") @db.Char(26)
  actionType     String   @map("action_type") @db.VarChar(80)
  targetType     String   @map("target_type") @db.VarChar(80)
  targetId       String   @map("target_id") @db.Char(26)
  requestId      String?  @map("request_id") @db.VarChar(128)
  ip             String?  @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(500)
  before         Json?
  after          Json?
  metadata       Json?
  createdAt      DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        Space?       @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  actor        User?        @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([spaceId])
  @@index([actorId])
  @@index([actionType])
  @@index([requestId])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([organizationId, requestId], map: "audit_logs_org_request_idx")
  @@index([organizationId, spaceId, targetType, targetId, createdAt], map: "audit_logs_org_space_target_created_idx")
  @@map("audit_logs")
}
