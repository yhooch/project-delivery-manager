generator client {
  provider   = "prisma-client"
  output     = "../apps/api/src/generated/prisma"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SessionRevocationReason {
  LOGOUT
  ROTATED
  EXPIRED
  ADMIN
}

enum OrganizationStatus {
  ACTIVE
  DISABLED
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationMemberStatus {
  ACTIVE
  DISABLED
}

enum Locale {
  zh_CN
  en_US
}

enum ThemeMode {
  SYSTEM
  LIGHT
  DARK
}

enum SpaceStatus {
  ACTIVE
  DISABLED
}

enum SpaceMemberStatus {
  ACTIVE
  DISABLED
}

enum SpaceRole {
  SPACE_ADMIN
  PM
  DEVELOPER
  TESTER
  REQUIREMENT
  MEMBER
  VIEWER
}

enum VersionStatus {
  PLANNED
  IN_PROGRESS
  RELEASED
  ARCHIVED
}

enum RequirementStatus {
  DRAFT
  CONFIRMED
  ARCHIVED
}

enum IntakeStatus {
  PENDING
  ACCEPTED
  DEFERRED
  REJECTED
  CONVERTED
}

enum IntakeSourceType {
  REQUIREMENT_CHANGE
  DEFECT_PROBLEM
  PROJECT_PLAN
  MEETING_DECISION
  AD_HOC
  IMPLEMENTATION
  OPERATIONS
  RELEASE
  EXTERNAL_COLLABORATION
}

enum ContentFormat {
  TIPTAP_JSON
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum StatusCategory {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  VERIFYING
  DONE
  TERMINATED
}

enum TargetType {
  SPACE
  VERSION
  REQUIREMENT
  INTAKE_ITEM
  WORK_ITEM
}

enum AttachmentTargetType {
  REQUIREMENT
  WORK_ITEM
}

enum CommentTargetType {
  REQUIREMENT
  INTAKE_ITEM
  WORK_ITEM
}

enum ObjectParticipantTargetType {
  REQUIREMENT
  INTAKE_ITEM
  WORK_ITEM
}

enum TagTargetType {
  REQUIREMENT
  INTAKE_ITEM
  WORK_ITEM
}

enum ObjectParticipantRelation {
  CREATOR
  ASSIGNEE
  REPORTER
  COMMENTER
  RELATED
}

enum WorkflowActorRelation {
  ASSIGNEE
  REPORTER
  CREATOR
  SPACE_OWNER
}

enum WorkflowDefinitionStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum WorkItemType {
  TASK
  BUG
}

enum BugSeverity {
  BLOCKER
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL
}

enum TimelineEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ACTION_EXECUTED
  ASSIGNEE_CHANGED
  COMMENTED
  ATTACHMENT_ADDED
  CLOSED
  REOPENED
}

enum ActionFormFieldType {
  TEXT
  TEXTAREA
  SELECT
  USER
  DATE
  NUMBER
}

model User {
  id           String     @id @db.Char(26)
  username     String     @unique @db.VarChar(32)
  passwordHash String     @map("password_hash")
  name         String     @db.VarChar(120)
  avatar       String?    @db.VarChar(500)
  status       UserStatus @default(ACTIVE)
  locale       Locale     @default(zh_CN)
  themeMode    ThemeMode  @default(SYSTEM) @map("theme_mode")
  lastLoginAt  DateTime? @db.Timestamptz(3)  @map("last_login_at")
  createdAt    DateTime @db.Timestamptz(3)   @default(now()) @map("created_at")
  updatedAt    DateTime @db.Timestamptz(3)   @updatedAt @map("updated_at")
  createdById  String?    @map("created_by_id") @db.Char(26)
  updatedById  String?    @map("updated_by_id") @db.Char(26)
  deletedAt    DateTime? @db.Timestamptz(3)  @map("deleted_at")

  sessions                  Session[]
  organizations             Organization[]       @relation("OrganizationOwner")
  memberships               OrganizationMember[]
  ownedSpaces               Space[]              @relation("SpaceOwner")
  spaceMemberships          SpaceMember[]
  ownedVersions             Version[]            @relation("VersionOwner")
  ownedRequirements         Requirement[]        @relation("RequirementOwner")
  authoredRequirements      Requirement[]        @relation("RequirementAuthor")
  uploadedAttachments       Attachment[]         @relation("AttachmentUploader")
  publishedWorkflowVersions WorkflowVersion[]    @relation("WorkflowVersionPublisher")
  objectParticipants        ObjectParticipant[]
  reportedIntakeItems       IntakeItem[]         @relation("IntakeItemReporter")
  assignedIntakeItems       IntakeItem[]         @relation("IntakeItemAssignee")
  reportedWorkItems         WorkItem[]           @relation("WorkItemReporter")
  assignedWorkItems         WorkItem[]           @relation("WorkItemAssignee")
  regressedBugDetails       BugDetail[]          @relation("BugDetailRegressionBy")
  authoredComments          Comment[]            @relation("CommentAuthor")
  actedTimelineEvents       TimelineEvent[]      @relation("TimelineEventActor")
  actedAuditLogs            AuditLog[]           @relation("AuditLogActor")
  createdTags               Tag[]                @relation("TagCreatedBy")
  updatedTags               Tag[]                @relation("TagUpdatedBy")
  assignedTagAssignments    TagAssignment[]      @relation("TagAssignmentAssignedBy")

  @@map("users")
}

model Session {
  id               String                   @id @db.Char(26)
  userId           String                   @map("user_id") @db.Char(26)
  tokenHash        String                   @map("token_hash") @db.VarChar(128)
  expiresAt        DateTime @db.Timestamptz(3)                 @map("expires_at")
  revokedAt        DateTime? @db.Timestamptz(3)                @map("revoked_at")
  revocationReason SessionRevocationReason? @map("revocation_reason")
  lastAccessedAt   DateTime @db.Timestamptz(3)                 @default(now()) @map("last_accessed_at")
  userAgent        String?                  @map("user_agent") @db.VarChar(500)
  ip               String?                  @db.VarChar(64)
  createdAt        DateTime @db.Timestamptz(3)                 @default(now()) @map("created_at")
  updatedAt        DateTime @db.Timestamptz(3)                 @updatedAt @map("updated_at")
  createdById      String?                  @map("created_by_id") @db.Char(26)
  updatedById      String?                  @map("updated_by_id") @db.Char(26)
  deletedAt        DateTime? @db.Timestamptz(3)                @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model Organization {
  id          String             @id @db.Char(26)
  name        String             @db.VarChar(120)
  code        String             @db.VarChar(32)
  ownerId     String?            @map("owner_id") @db.Char(26)
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime @db.Timestamptz(3)           @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamptz(3)           @updatedAt @map("updated_at")
  createdById String?            @map("created_by_id") @db.Char(26)
  updatedById String?            @map("updated_by_id") @db.Char(26)
  deletedAt   DateTime? @db.Timestamptz(3)          @map("deleted_at")

  owner               User?                @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members             OrganizationMember[]
  spaces              Space[]
  spaceMembers        SpaceMember[]
  versions            Version[]
  requirements        Requirement[]
  attachments         Attachment[]
  workflowDefinitions WorkflowDefinition[]
  workflowBindings    WorkflowBinding[]
  objectParticipants  ObjectParticipant[]
  intakeItems         IntakeItem[]
  workItems           WorkItem[]
  auditLogs           AuditLog[]
  comments            Comment[]
  timelineEvents      TimelineEvent[]
  tags                Tag[]
  tagAssignments      TagAssignment[]

  @@index([ownerId])
  @@index([code])
  @@map("organizations")
}

model OrganizationMember {
  id             String                   @id @db.Char(26)
  organizationId String                   @map("organization_id") @db.Char(26)
  userId         String                   @map("user_id") @db.Char(26)
  role           OrganizationRole
  status         OrganizationMemberStatus @default(ACTIVE)
  createdAt      DateTime @db.Timestamptz(3)                 @default(now()) @map("created_at")
  updatedAt      DateTime @db.Timestamptz(3)                 @updatedAt @map("updated_at")
  createdById    String?                  @map("created_by_id") @db.Char(26)
  updatedById    String?                  @map("updated_by_id") @db.Char(26)
  deletedAt      DateTime? @db.Timestamptz(3)                @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Space {
  id                 String      @id @db.Char(26)
  organizationId     String      @map("organization_id") @db.Char(26)
  name               String      @db.VarChar(120)
  code               String      @db.VarChar(32)
  description        String?     @db.VarChar(2000)
  ownerId            String?     @map("owner_id") @db.Char(26)
  status             SpaceStatus @default(ACTIVE)
  staleThresholdDays Int         @default(3) @map("stale_threshold_days")
  createdAt          DateTime @db.Timestamptz(3)    @default(now()) @map("created_at")
  updatedAt          DateTime @db.Timestamptz(3)    @updatedAt @map("updated_at")
  createdById        String?     @map("created_by_id") @db.Char(26)
  updatedById        String?     @map("updated_by_id") @db.Char(26)
  deletedAt          DateTime? @db.Timestamptz(3)   @map("deleted_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner               User?                @relation("SpaceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members             SpaceMember[]
  versions            Version[]
  requirements        Requirement[]
  attachments         Attachment[]
  workflowDefinitions WorkflowDefinition[]
  workflowBindings    WorkflowBinding[]
  objectParticipants  ObjectParticipant[]
  intakeItems         IntakeItem[]
  workItems           WorkItem[]
  auditLogs           AuditLog[]
  comments            Comment[]
  timelineEvents      TimelineEvent[]
  tags                Tag[]
  tagAssignments      TagAssignment[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([code])
  @@map("spaces")
}

model SpaceMember {
  id             String            @id @db.Char(26)
  organizationId String            @map("organization_id") @db.Char(26)
  spaceId        String            @map("space_id") @db.Char(26)
  userId         String            @map("user_id") @db.Char(26)
  role           SpaceRole
  status         SpaceMemberStatus @default(ACTIVE)
  createdAt      DateTime @db.Timestamptz(3)          @default(now()) @map("created_at")
  updatedAt      DateTime @db.Timestamptz(3)          @updatedAt @map("updated_at")
  createdById    String?           @map("created_by_id") @db.Char(26)
  updatedById    String?           @map("updated_by_id") @db.Char(26)
  deletedAt      DateTime? @db.Timestamptz(3)         @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([spaceId])
  @@index([userId])
  @@map("space_members")
}

model Version {
  id               String        @id @db.Char(26)
  organizationId   String        @map("organization_id") @db.Char(26)
  spaceId          String        @map("space_id") @db.Char(26)
  name             String        @db.VarChar(120)
  target           String?       @db.VarChar(2000)
  description      String?       @db.VarChar(2000)
  ownerId          String?       @map("owner_id") @db.Char(26)
  status           VersionStatus @default(PLANNED)
  startDate        DateTime? @db.Timestamptz(3)     @map("start_date")
  targetDate       DateTime? @db.Timestamptz(3)     @map("target_date")
  releaseDate      DateTime? @db.Timestamptz(3)     @map("release_date")
  requirementCount Int           @default(0) @map("requirement_count")
  taskCount        Int           @default(0) @map("task_count")
  bugCount         Int           @default(0) @map("bug_count")
  blockedCount     Int           @default(0) @map("blocked_count")
  createdAt        DateTime @db.Timestamptz(3)      @default(now()) @map("created_at")
  updatedAt        DateTime @db.Timestamptz(3)      @updatedAt @map("updated_at")
  createdById      String?       @map("created_by_id") @db.Char(26)
  updatedById      String?       @map("updated_by_id") @db.Char(26)
  deletedAt        DateTime? @db.Timestamptz(3)     @map("deleted_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  owner        User?         @relation("VersionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  requirements Requirement[]
  intakeItems  IntakeItem[]
  workItems    WorkItem[]

  @@index([organizationId])
  @@index([spaceId])
  @@index([ownerId])
  @@index([status])
  @@map("versions")
}

model Requirement {
  id                   String            @id @db.Char(26)
  organizationId       String            @map("organization_id") @db.Char(26)
  spaceId              String            @map("space_id") @db.Char(26)
  versionId            String?           @map("version_id") @db.Char(26)
  title                String            @default("") @db.VarChar(200)
  summary              String?           @db.VarChar(2000)
  contentJson          Json              @default("{}") @map("content_json")
  contentText          String?           @map("content_text") @db.Text
  contentMarkdownCache String?           @map("content_markdown_cache") @db.Text
  contentFormat        ContentFormat     @default(TIPTAP_JSON) @map("content_format")
  status               RequirementStatus @default(DRAFT)
  priority             Priority?
  ownerId              String?           @map("owner_id") @db.Char(26)
  authorId             String?           @map("author_id") @db.Char(26)
  createdAt            DateTime @db.Timestamptz(3)          @default(now()) @map("created_at")
  updatedAt            DateTime @db.Timestamptz(3)          @updatedAt @map("updated_at")
  createdById          String?           @map("created_by_id") @db.Char(26)
  updatedById          String?           @map("updated_by_id") @db.Char(26)
  deletedAt            DateTime? @db.Timestamptz(3)         @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  version      Version?     @relation(fields: [versionId], references: [id], onDelete: SetNull)
  owner        User?        @relation("RequirementOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  author       User?        @relation("RequirementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  intakeItems  IntakeItem[]
  workItems    WorkItem[]

  @@index([organizationId])
  @@index([spaceId])
  @@index([versionId])
  @@index([ownerId])
  @@index([authorId])
  @@index([status])
  @@map("requirements")
}

model IntakeItem {
  id             String           @id @db.Char(26)
  organizationId String           @map("organization_id") @db.Char(26)
  spaceId        String           @map("space_id") @db.Char(26)
  versionId      String?          @map("version_id") @db.Char(26)
  requirementId  String?          @map("requirement_id") @db.Char(26)
  title          String           @db.VarChar(200)
  description    String?          @db.VarChar(8000)
  sourceType     IntakeSourceType @map("source_type")
  sourceObject   Json?            @map("source_object")
  reporterId     String           @map("reporter_id") @db.Char(26)
  assigneeId     String?          @map("assignee_id") @db.Char(26)
  priority       Priority?
  status         IntakeStatus     @default(PENDING)
  acceptedAt     DateTime? @db.Timestamptz(3)        @map("accepted_at")
  convertedAt    DateTime? @db.Timestamptz(3)        @map("converted_at")
  createdAt      DateTime @db.Timestamptz(3)         @default(now()) @map("created_at")
  updatedAt      DateTime @db.Timestamptz(3)         @updatedAt @map("updated_at")
  createdById    String?          @map("created_by_id") @db.Char(26)
  updatedById    String?          @map("updated_by_id") @db.Char(26)
  deletedAt      DateTime? @db.Timestamptz(3)        @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  version      Version?     @relation(fields: [versionId], references: [id], onDelete: SetNull)
  requirement  Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  reporter     User         @relation("IntakeItemReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee     User?        @relation("IntakeItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  workItems    WorkItem[]

  @@index([organizationId])
  @@index([spaceId])
  @@index([versionId])
  @@index([requirementId])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([sourceType])
  @@index([spaceId, status])
  @@index([spaceId, assigneeId])
  @@map("intake_items")
}

model WorkItem {
  id                  String         @id @db.Char(26)
  organizationId      String         @map("organization_id") @db.Char(26)
  spaceId             String         @map("space_id") @db.Char(26)
  versionId           String?        @map("version_id") @db.Char(26)
  requirementId       String?        @map("requirement_id") @db.Char(26)
  intakeItemId        String?        @map("intake_item_id") @db.Char(26)
  type                WorkItemType   @default(TASK)
  title               String         @db.VarChar(200)
  description         String?        @db.VarChar(8000)
  priority            Priority       @default(MEDIUM)
  assigneeId          String?        @map("assignee_id") @db.Char(26)
  reporterId          String         @map("reporter_id") @db.Char(26)
  workflowVersionId   String         @map("workflow_version_id") @db.Char(26)
  currentStateId      String         @map("current_state_id") @db.Char(26)
  statusCategory      StatusCategory @map("status_category")
  dueDate             DateTime? @db.Timestamptz(3)      @map("due_date")
  lastStatusChangedAt DateTime @db.Timestamptz(3)       @map("last_status_changed_at")
  lastActionAt        DateTime? @db.Timestamptz(3)      @map("last_action_at")
  blockedReason       String?        @map("blocked_reason") @db.VarChar(1000)
  blockedAt           DateTime? @db.Timestamptz(3)      @map("blocked_at")
  closedAt            DateTime? @db.Timestamptz(3)      @map("closed_at")
  createdAt           DateTime @db.Timestamptz(3)       @default(now()) @map("created_at")
  updatedAt           DateTime @db.Timestamptz(3)       @updatedAt @map("updated_at")
  createdById         String?        @map("created_by_id") @db.Char(26)
  updatedById         String?        @map("updated_by_id") @db.Char(26)
  deletedAt           DateTime? @db.Timestamptz(3)      @map("deleted_at")

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space             Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  version           Version?        @relation(fields: [versionId], references: [id], onDelete: SetNull)
  requirement       Requirement?    @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  intakeItem        IntakeItem?     @relation(fields: [intakeItemId], references: [id], onDelete: SetNull)
  assignee          User?           @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter          User            @relation("WorkItemReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  currentState      WorkflowState   @relation(fields: [currentStateId], references: [id], onDelete: Restrict)
  bugDetail         BugDetail?      @relation("BugDetailWorkItem")
  relatedBugDetails BugDetail[]     @relation("BugDetailRelatedTask")

  @@index([organizationId])
  @@index([spaceId])
  @@index([versionId])
  @@index([requirementId])
  @@index([intakeItemId])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([workflowVersionId])
  @@index([currentStateId])
  @@index([type])
  @@index([statusCategory])
  @@index([priority])
  @@index([dueDate])
  @@index([lastStatusChangedAt])
  @@index([spaceId, intakeItemId])
  @@index([spaceId, assigneeId])
  @@index([spaceId, statusCategory])
  @@index([spaceId, type])
  @@map("work_items")
}

model BugDetail {
  workItemId       String      @id @map("work_item_id") @db.Char(26)
  severity         BugSeverity
  stepsToReproduce String?     @map("steps_to_reproduce") @db.VarChar(8000)
  expectedResult   String?     @map("expected_result") @db.VarChar(8000)
  actualResult     String?     @map("actual_result") @db.VarChar(8000)
  fixNote          String?     @map("fix_note") @db.VarChar(8000)
  regressionResult String?     @map("regression_result") @db.VarChar(8000)
  regressionById   String?     @map("regression_by_id") @db.Char(26)
  regressionAt     DateTime? @db.Timestamptz(3)   @map("regression_at")
  relatedTaskId    String?     @map("related_task_id") @db.Char(26)
  createdAt        DateTime @db.Timestamptz(3)    @default(now()) @map("created_at")
  updatedAt        DateTime @db.Timestamptz(3)    @updatedAt @map("updated_at")
  createdById      String?     @map("created_by_id") @db.Char(26)
  updatedById      String?     @map("updated_by_id") @db.Char(26)
  deletedAt        DateTime? @db.Timestamptz(3)   @map("deleted_at")

  workItem     WorkItem  @relation("BugDetailWorkItem", fields: [workItemId], references: [id], onDelete: Cascade)
  regressionBy User?     @relation("BugDetailRegressionBy", fields: [regressionById], references: [id], onDelete: SetNull)
  relatedTask  WorkItem? @relation("BugDetailRelatedTask", fields: [relatedTaskId], references: [id], onDelete: SetNull)

  @@index([severity])
  @@index([regressionById])
  @@index([relatedTaskId])
  @@map("bug_details")
}

model Attachment {
  id             String               @id @db.Char(26)
  organizationId String               @map("organization_id") @db.Char(26)
  spaceId        String               @map("space_id") @db.Char(26)
  targetType     AttachmentTargetType @map("target_type")
  targetId       String               @map("target_id") @db.Char(26)
  fileName       String               @map("file_name") @db.VarChar(500)
  fileKey        String               @map("file_key") @db.VarChar(1000)
  mimeType       String               @map("mime_type") @db.VarChar(255)
  size           Int
  uploadedById   String?              @map("uploaded_by_id") @db.Char(26)
  createdAt      DateTime @db.Timestamptz(3)             @default(now()) @map("created_at")
  updatedAt      DateTime @db.Timestamptz(3)             @updatedAt @map("updated_at")
  createdById    String?              @map("created_by_id") @db.Char(26)
  updatedById    String?              @map("updated_by_id") @db.Char(26)
  deletedAt      DateTime? @db.Timestamptz(3)            @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  uploadedBy   User?        @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([spaceId])
  @@index([targetType, targetId])
  @@index([organizationId, spaceId, targetType, targetId, deletedAt, createdAt], map: "attachments_org_space_target_deleted_created_idx")
  @@index([uploadedById])
  @@map("attachments")
}

model Tag {
  id             String    @id @db.Char(26)
  organizationId String    @map("organization_id") @db.Char(26)
  spaceId        String    @map("space_id") @db.Char(26)
  name           String    @db.VarChar(40)
  normalizedName String    @map("normalized_name") @db.VarChar(80)
  colorKey       String    @map("color_key") @db.VarChar(32)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdById    String?   @map("created_by_id") @db.Char(26)
  updatedById    String?   @map("updated_by_id") @db.Char(26)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation("TagCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?           @relation("TagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  assignments  TagAssignment[]

  @@index([organizationId])
  @@index([spaceId])
  @@index([normalizedName])
  @@index([spaceId, normalizedName])
  @@index([createdById])
  @@index([updatedById])
  @@map("tags")
}

