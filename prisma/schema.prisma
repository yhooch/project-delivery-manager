model WorkflowDefinition {
  id             String                   @id @db.Char(26)
  organizationId String                   @map("organization_id") @db.Char(26)
  spaceId        String                   @map("space_id") @db.Char(26)
  code           String                   @db.VarChar(80)
  name           String                   @db.VarChar(120)
  description    String?                  @db.VarChar(2000)
  status         WorkflowDefinitionStatus @default(DRAFT)
  createdAt      DateTime @db.Timestamptz(3)                 @default(now()) @map("created_at")
  updatedAt      DateTime @db.Timestamptz(3)                 @updatedAt @map("updated_at")
  createdById    String?                  @map("created_by_id") @db.Char(26)
  updatedById    String?                  @map("updated_by_id") @db.Char(26)
  deletedAt      DateTime? @db.Timestamptz(3)                @map("deleted_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  versions     WorkflowVersion[]
  bindings     WorkflowBinding[]

  @@index([organizationId])
  @@index([spaceId])
  @@index([code])
  @@map("workflow_definitions")
}

model WorkflowVersion {
  id                   String                @id @db.Char(26)
  workflowDefinitionId String                @map("workflow_definition_id") @db.Char(26)
  version              Int
  status               WorkflowVersionStatus @default(DRAFT)
  publishedAt          DateTime? @db.Timestamptz(3)             @map("published_at")
  publishedById        String?               @map("published_by_id") @db.Char(26)
  createdAt            DateTime @db.Timestamptz(3)              @default(now()) @map("created_at")
  updatedAt            DateTime @db.Timestamptz(3)              @updatedAt @map("updated_at")
  createdById          String?               @map("created_by_id") @db.Char(26)
  updatedById          String?               @map("updated_by_id") @db.Char(26)
  deletedAt            DateTime? @db.Timestamptz(3)             @map("deleted_at")

  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  publishedBy        User?              @relation("WorkflowVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  states             WorkflowState[]
  actions            WorkflowAction[]
  bindings           WorkflowBinding[]
  workItems          WorkItem[]

  @@index([workflowDefinitionId])
  @@index([status])
  @@index([publishedById])
  @@map("workflow_versions")
}

model WorkflowState {
  id                String         @id @db.Char(26)
  workflowVersionId String         @map("workflow_version_id") @db.Char(26)
  code              String         @db.VarChar(80)
  name              String         @db.VarChar(120)
  category          StatusCategory
  isStart           Boolean        @default(false) @map("is_start")
  isEnd             Boolean        @default(false) @map("is_end")
  sortOrder         Int            @default(0) @map("sort_order")
  createdAt         DateTime @db.Timestamptz(3)       @default(now()) @map("created_at")
  updatedAt         DateTime @db.Timestamptz(3)       @updatedAt @map("updated_at")
  createdById       String?        @map("created_by_id") @db.Char(26)
  updatedById       String?        @map("updated_by_id") @db.Char(26)
  deletedAt         DateTime? @db.Timestamptz(3)      @map("deleted_at")

  workflowVersion WorkflowVersion  @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  outgoingActions WorkflowAction[] @relation("WorkflowActionFromState")
  incomingActions WorkflowAction[] @relation("WorkflowActionToState")
  workItems       WorkItem[]

  @@index([workflowVersionId])
  @@index([category])
  @@map("workflow_states")
}

model WorkflowAction {
  id                String                  @id @db.Char(26)
  workflowVersionId String                  @map("workflow_version_id") @db.Char(26)
  fromStateId       String                  @map("from_state_id") @db.Char(26)
  toStateId         String                  @map("to_state_id") @db.Char(26)
  code              String                  @db.VarChar(80)
  name              String                  @db.VarChar(120)
  allowedSpaceRoles SpaceRole[]             @default([]) @map("allowed_space_roles")
  actorRelations    WorkflowActorRelation[] @default([]) @map("actor_relations")
  requiresComment   Boolean                 @default(false) @map("requires_comment")
  sortOrder         Int                     @default(0) @map("sort_order")
  createdAt         DateTime @db.Timestamptz(3)                @default(now()) @map("created_at")
  updatedAt         DateTime @db.Timestamptz(3)                @updatedAt @map("updated_at")
  createdById       String?                 @map("created_by_id") @db.Char(26)
  updatedById       String?                 @map("updated_by_id") @db.Char(26)
  deletedAt         DateTime? @db.Timestamptz(3)               @map("deleted_at")

  workflowVersion WorkflowVersion   @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  fromState       WorkflowState     @relation("WorkflowActionFromState", fields: [fromStateId], references: [id], onDelete: Cascade)
  toState         WorkflowState     @relation("WorkflowActionToState", fields: [toStateId], references: [id], onDelete: Cascade)
  formFields      ActionFormField[]

  @@index([workflowVersionId])
  @@index([fromStateId])
  @@index([toStateId])
  @@map("workflow_actions")
}

model ActionFormField {
  id          String              @id @db.Char(26)
  actionId    String              @map("action_id") @db.Char(26)
  key         String              @db.VarChar(80)
  label       String              @db.VarChar(120)
  fieldType   ActionFormFieldType @map("field_type")
  required    Boolean             @default(false)
  options     String[]            @default([])
  sortOrder   Int                 @default(0) @map("sort_order")
  createdAt   DateTime @db.Timestamptz(3)            @default(now()) @map("created_at")
  updatedAt   DateTime @db.Timestamptz(3)            @updatedAt @map("updated_at")
  createdById String?             @map("created_by_id") @db.Char(26)
  updatedById String?             @map("updated_by_id") @db.Char(26)
  deletedAt   DateTime? @db.Timestamptz(3)           @map("deleted_at")

  action WorkflowAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@map("action_form_fields")
}

model WorkflowBinding {
  id                   String        @id @db.Char(26)
  organizationId       String        @map("organization_id") @db.Char(26)
  spaceId              String        @map("space_id") @db.Char(26)
  workflowDefinitionId String        @map("workflow_definition_id") @db.Char(26)
  workflowVersionId    String        @map("workflow_version_id") @db.Char(26)
  targetType           TargetType    @default(WORK_ITEM) @map("target_type")
  workItemType         WorkItemType? @map("work_item_type")
  priority             Priority?
  isDefault            Boolean       @default(false) @map("is_default")
  createdAt            DateTime @db.Timestamptz(3)      @default(now()) @map("created_at")
  updatedAt            DateTime @db.Timestamptz(3)      @updatedAt @map("updated_at")
  createdById          String?       @map("created_by_id") @db.Char(26)
  updatedById          String?       @map("updated_by_id") @db.Char(26)
  deletedAt            DateTime? @db.Timestamptz(3)     @map("deleted_at")

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space              Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  workflowDefinition WorkflowDefinition @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  workflowVersion    WorkflowVersion    @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([spaceId])
  @@index([workflowDefinitionId])
  @@index([workflowVersionId])
  @@index([targetType, workItemType])
  @@map("workflow_bindings")
}

