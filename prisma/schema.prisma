  spaceId        String            @map("space_id") @db.Char(26)
  targetType     CommentTargetType @map("target_type")
  targetId       String            @map("target_id") @db.Char(26)
  authorId       String            @map("author_id") @db.Char(26)
  body           String            @db.VarChar(8000)
  createdAt      DateTime @db.Timestamptz(3)          @default(now()) @map("created_at")
  updatedAt      DateTime @db.Timestamptz(3)          @updatedAt @map("updated_at")
  createdById    String?           @map("created_by_id") @db.Char(26)
  updatedById    String?           @map("updated_by_id") @db.Char(26)
