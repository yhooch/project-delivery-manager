# Reference environment for the E2E orchestrators.
#
# scripts/e2e/run.sh injects these Docker-compatible values.
# scripts/e2e/run-local.sh uses the same contract without Docker, but has
# safer /tmp-local defaults for DB and bucket when those vars are not exported.
#
# Override any of these by exporting them before invoking
# `corepack pnpm test:e2e:full` or `corepack pnpm test:e2e:local`.

# --- Postgres (matches docker-compose.e2e.yml defaults) ----------------------
E2E_PG_PORT=55432
E2E_PG_USER=e2e
E2E_PG_PASSWORD=e2e
E2E_PG_DB=project_delivery_manager_e2e
E2E_WAIT_DB_SECS=60

# Local no-Docker path only. If DATABASE_URL is not set, run-local.sh
# initializes/reuses this cluster. Its built-in default DB name is
# project_delivery_manager_e2e_local; exporting this file overrides it with
# E2E_PG_DB above.
E2E_LOCAL_PGDATA=/tmp/crm-manager-pg

# DATABASE_URL handed to prisma migrate / API. Derived from the four vars above
# at run time, but exposed here so you can hard-pin it if you need to.
DATABASE_URL=postgresql://e2e:e2e@127.0.0.1:55432/project_delivery_manager_e2e
# If you hard-pin DATABASE_URL to a DB whose name does not contain "e2e" or
# "test", run-local.sh refuses to run unless this is set after manual review.
E2E_ALLOW_NON_E2E_DATABASE=0

# --- MinIO (matches docker-compose.e2e.yml defaults) -------------------------
E2E_MINIO_PORT=59000
E2E_MINIO_CONSOLE_PORT=59001
E2E_WAIT_MINIO_SECS=60
# Local no-Docker path only. run-local.sh stores object data here by default
# and uses crm-manager-attachments-e2e-local unless MINIO_BUCKET is exported.
E2E_MINIO_DATA_DIR=/tmp/crm-manager-minio-e2e
MINIO_INTERNAL_ENDPOINT=http://127.0.0.1:59000
MINIO_BUCKET=crm-manager-attachments-e2e
MINIO_ACCESS_KEY=e2e-minio
MINIO_SECRET_KEY=e2e-minio-secret
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
MINIO_AUTO_CREATE_BUCKET=false

# --- API (NestJS) -----------------------------------------------------------
NODE_ENV=test
PORT=3001
SESSION_COOKIE_NAME=pdm_session
WEB_APP_URL=http://127.0.0.1:3000

# --- Web (Next.js) ----------------------------------------------------------
# Next start binds to this port; Playwright probes it via E2E_WEB_URL.
WEB_PORT=3000

# --- Playwright gates -------------------------------------------------------
E2E_M0_ENABLED=1
E2E_M3_ENABLED=1
E2E_M4_ENABLED=1
E2E_UI_ENABLED=1
E2E_DB_READY=1
E2E_REQUIRE_WEB=1
E2E_API_URL=http://127.0.0.1:3001/api/v1
E2E_WEB_URL=http://127.0.0.1:3000
E2E_KEEP_UP=0
